QWidget#applicationRoot {
    background-color: {{colors.background_primary}};
    border-image: url("assets/background_stone.jpg") 0 0 0 0 stretch stretch;
    color: {{colors.text_primary}};
    font-family: "{{typography.font_body}}";
    font-size: {{typography.size_body}};
}

QScrollArea#settingsScrollArea,
QScrollArea#settingsScrollArea QWidget#qt_scrollarea_viewport {
    background-color: transparent;
    border: none;
}

QFrame[role="header"], QFrame[role="navigation"] {
    background-color: {{colors.background_elevated}};
    border: {{geometry.border_width}} solid {{colors.border_highlight}};
    border-radius: {{geometry.border_radius_small}};
}

QFrame[role="content"], QFrame[role="sidebar"] {
    background-color: {{colors.background_secondary}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
}

QFrame[role="panel"] {
    background-color: {{colors.panel_surface}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
}

QScrollArea#merchantTradeScroll,
QScrollArea#merchantTradeScroll QWidget#qt_scrollarea_viewport,
QWidget#merchantTradeContent {
    background-color: transparent;
    color: {{colors.text_primary}};
    border: none;
}

QFrame#merchantTradePanel QLabel[rarity="common"] { color: {{colors.rarity_common}}; }
QFrame#merchantTradePanel QLabel[rarity="uncommon"] { color: {{colors.rarity_uncommon}}; }
QFrame#merchantTradePanel QLabel[rarity="rare"] { color: {{colors.rarity_rare}}; }
QFrame#merchantTradePanel QLabel[rarity="epic"] { color: {{colors.rarity_epic}}; }
QFrame#merchantTradePanel QLabel[rarity="legendary"] { color: {{colors.rarity_legendary}}; }

QPushButton#npcSuggestedResponse {
    padding-left: 2px;
    padding-right: 2px;
}

QWidget#craftingUtilityPage,
QScrollArea#craftingRecipeScroll,
QScrollArea#craftingRecipeScroll QWidget#qt_scrollarea_viewport,
QWidget#craftingRecipeContent {
    background-color: transparent;
    color: {{colors.text_primary}};
    border: none;
}

QDialog#craftingResultsDialog {
    background-color: {{colors.background_secondary}};
    color: {{colors.text_primary}};
}

QFrame#diceRollBanner {
    background: rgba(13, 11, 9, 225);
    border: 1px solid {{colors.border_highlight}};
    border-radius: 10px;
}
QWidget#diceRollDie {
    qproperty-faceColor: #15110c;
    qproperty-edgeColor: {{colors.accent_primary}};
    qproperty-textColor: {{colors.text_primary}};
    qproperty-successColor: {{colors.success}};
    qproperty-failureColor: {{colors.danger}};
}
QLabel#diceRollTitle {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_display}}";
    font-size: 12px;
    font-weight: {{typography.weight_bold}};
    letter-spacing: 1px;
    background: transparent;
}
QLabel#diceRollDetail {
    color: {{colors.text_secondary}};
    font-size: 13px;
    background: transparent;
}
QLabel#diceRollOutcome {
    color: {{colors.text_secondary}};
    font-family: "{{typography.font_display}}";
    font-size: 18px;
    font-weight: {{typography.weight_bold}};
    letter-spacing: 2px;
    background: transparent;
}
QLabel#diceRollDetail[checkState="success"], QLabel#diceRollOutcome[checkState="success"] { color: {{colors.success}}; }
QLabel#diceRollDetail[checkState="failure"], QLabel#diceRollOutcome[checkState="failure"] { color: {{colors.danger}}; }

QLabel#craftingResultsTitle {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_display}}";
    font-size: {{typography.size_title}};
    font-weight: {{typography.weight_bold}};
}

QLabel#craftingResultsSummary, QLabel#craftingResultDetail,
QLabel#craftingResultItemText {
    color: {{colors.text_primary}};
}

QFrame#craftingResultTotals, QFrame#craftingResultItem {
    background-color: {{colors.panel_surface_alt}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
}

QLabel#craftingResultTotal {
    color: {{colors.loot}};
    font-size: {{typography.size_heading_2}};
    font-weight: {{typography.weight_bold}};
}

QFrame#craftingResultItem[rarity="common"] { border-color: {{colors.rarity_common}}; }
QFrame#craftingResultItem[rarity="uncommon"] { border-color: {{colors.rarity_uncommon}}; }
QFrame#craftingResultItem[rarity="rare"] { border-color: {{colors.rarity_rare}}; }
QFrame#craftingResultItem[rarity="epic"] { border-color: {{colors.rarity_epic}}; }
QFrame#craftingResultItem[rarity="legendary"] { border-color: {{colors.rarity_legendary}}; }

/* Title bar: no box. The header sits on the page; a fading hairline with a shield crest
   runs under it. Sizes are fixed because the bar height is. Small caps is set in code. */
QFrame#topHeader {
    background: transparent;
    border: none;
    border-radius: 0;
}

QLabel#titleOrnamentLeft { image: url("assets/title_rule_left.png"); }
QLabel#titleOrnamentRight { image: url("assets/title_rule_right.png"); }
QLabel#headerRuleLeft { border-image: url("assets/header_rule_left.png") 0 0 0 0 stretch stretch; }
QLabel#headerRuleRight { border-image: url("assets/header_rule_right.png") 0 0 0 0 stretch stretch; }
QLabel#headerCrest { image: url("assets/header_crest.png"); }

QLabel#applicationTitle {
    color: #e0bd74;
    font-family: "{{typography.font_display}}";
    font-size: 24px; /* font-scale-fixed */
    font-weight: {{typography.weight_normal}};
    letter-spacing: 3px;
    padding: 0 10px;
}

QLabel#phaseLabel {
    color: #8f8068;
    font-family: "Oxanium";
    font-size: 11px; /* font-scale-fixed */
    font-weight: 600;
    letter-spacing: 3px;
}

QLabel#themeLabel {
    color: #8f8068;
    font-family: "{{typography.font_display}}";
    font-size: 12px; /* font-scale-fixed */
    font-style: italic;
    padding: 0 4px 0 0;
}

QComboBox#themeSelector {
    color: {{codex.ink}};
    background: transparent;
    font-family: "{{typography.font_display}}";
    font-size: 13px; /* font-scale-fixed */
    min-width: 150px;
    padding: 0 18px 1px 2px;
    border: none;
    border-bottom: 1px solid {{codex.gold_dark}};
    border-radius: 0;
}

QComboBox#themeSelector:hover, QComboBox#themeSelector:focus, QComboBox#themeSelector:on {
    color: #f2d592;
    background-color: rgba(217, 180, 108, 18);
    border: none;
    border-bottom: 1px solid {{codex.gold}};
}

QComboBox#themeSelector::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 14px;
    border: none;
    background: transparent;
}

QComboBox#themeSelector::down-arrow {
    image: url("../../assets/codex/markers/ui_dropdown_arrow.png");
    width: 8px;
    height: 8px;
}

QComboBox#themeSelector QAbstractItemView {
    background-color: #17130e;
    color: {{codex.ink}};
    border: 1px solid {{codex.gold_dark}};
    selection-background-color: #3a2a16;
    selection-color: #f2d592;
    font-family: "{{typography.font_display}}";
}

QPushButton#windowMinimizeButton, QPushButton#windowMaximizeButton,
QPushButton#windowCloseButton {
    color: #c9a865;
    background: transparent;
    font-family: "{{typography.font_display}}";
    font-size: 18px; /* font-scale-fixed */
    font-weight: {{typography.weight_normal}};
    padding: 0 0 2px 0;
    border: 1px solid transparent;
    border-radius: 3px;
}

QPushButton#windowMinimizeButton:hover, QPushButton#windowMaximizeButton:hover,
QPushButton#windowMinimizeButton:focus, QPushButton#windowMaximizeButton:focus {
    color: #f2d592;
    background-color: rgba(217, 180, 108, 30);
    border: 1px solid rgba(217, 180, 108, 90);
}

QPushButton#windowCloseButton:hover, QPushButton#windowCloseButton:focus {
    color: #ffe9de;
    background-color: rgba(150, 36, 26, 220);
    border: 1px solid #c0573f;
}

QLabel#placeholderLabel {
    color: {{colors.text_secondary}};
    font-family: "{{typography.font_heading}}";
    font-size: {{typography.size_heading_1}};
}

QLabel#panelTitle, QLabel[textRole="heading"] {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_heading}}";
    font-size: {{typography.size_heading_1}};
    font-weight: {{typography.weight_bold}};
}

QLabel[textRole="secondary"], QLabel[textRole="system"] {
    color: {{colors.text_secondary}};
}

QLabel[textRole="body"] {
    color: {{colors.text_primary}};
}

QLabel[textRole="muted"] {
    color: {{colors.text_muted}};
    font-size: {{typography.size_small}};
}

QLabel[textRole="accent"], QLabel[textRole="quest"] {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_heading}}";
}

QLabel[textRole="success"], QLabel[textRole="experience"] {
    color: {{colors.success}};
}

QLabel[textRole="warning"], QLabel[textRole="loot"], QLabel[textRole="focus"] {
    color: {{colors.warning}};
}

QLabel[textRole="health"], QLabel[textRole="danger"] {
    color: {{colors.danger}};
}

QLabel[textRole="stamina"], QLabel[textRole="resolve"] {
    color: {{colors.experience}};
}

QLabel[textRole="narrative"] {
    color: {{colors.text_primary}};
    font-size: {{typography.size_body}};
    font-style: normal;
    font-weight: {{typography.weight_normal}};
}

QLabel[textRole="monologue"] {
    color: {{colors.text_secondary}};
    font-size: {{typography.size_body}};
    font-style: italic;
    font-weight: {{typography.weight_normal}};
}

QLabel[textRole="spoken"], QLabel[textRole="dialogue"] {
    color: {{colors.dialogue}};
    font-size: {{typography.size_heading_2}};
    font-weight: {{typography.weight_bold}};
}

QLabel[textRole="playerAction"] {
    color: {{colors.accent_primary}};
    font-weight: {{typography.weight_bold}};
}

QLabel[textRole="combat"] {
    color: #e6a23c;
    font-weight: 600;
}

QScrollArea#combatUtilityPage,
QScrollArea#combatUtilityPage QWidget#qt_scrollarea_viewport,
QWidget#combatUtilityContent {
    background-color: transparent;
    border: none;
}

QWidget#combatUtilityContent QLabel#combatantRow[activeTurn="true"] {
    color: #f1c75b;
    border-left: 3px solid #c99524;
    padding-left: 5px;
}

QWidget#combatUtilityContent QLabel#combatantRow[combatSide="enemy"] {
    color: {{colors.text_secondary}};
    background-color: rgba(95, 32, 27, 0.25);
    padding: 4px;
}

QWidget#combatUtilityContent QLabel#combatLogEntry {
    border-bottom: 1px solid rgba(201, 149, 36, 0.35);
    padding: 3px 0;
}

QWidget#combatUtilityContent QLabel#combatActionDetail {
    color: #c9b88e;
    padding: 2px 4px 4px 4px;
    font-size: 11px;
}

QLabel#portraitPlaceholder, QLabel#locationVisualPlaceholder,
QLabel#minimapCanvas, QLabel#inventoryPreviewSlot {
    background-color: {{colors.panel_surface_alt}};
    color: {{colors.text_secondary}};
    border: {{geometry.border_width}} solid {{colors.border_highlight}};
    border-radius: {{geometry.border_radius_small}};
    padding: {{spacing.space_sm}};
}

QLabel#portraitPlaceholder[visualState="confirmed"],
QLabel#locationVisualPlaceholder[visualState="confirmed"] {
    background-color: {{colors.background_primary}};
    border-color: {{colors.success}};
}

QLabel#portraitPlaceholder[visualState="pending"],
QLabel#locationVisualPlaceholder[visualState="pending"] {
    color: {{colors.warning}};
    border-color: {{colors.warning}};
}

QLabel#portraitPlaceholder[visualState="missing"],
QLabel#locationVisualPlaceholder[visualState="missing"] {
    color: {{colors.danger}};
    border-color: {{colors.danger}};
}

QLabel#portraitPlaceholder, QLabel#minimapCanvas {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_display}}";
    font-size: {{typography.size_heading_1}};
    font-weight: {{typography.weight_bold}};
}

QLabel#inventoryPreviewSlot {
    font-size: {{typography.size_small}};
}

QScrollArea#narrativeScrollArea, QWidget#narrativeHistory {
    background-color: transparent;
    border: none;
}

QProgressBar#resourceBar {
    background-color: {{colors.background_primary}};
    color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
    min-height: 15px;
    text-align: center;
    font-size: {{typography.size_small}};
}

QProgressBar#resourceBar::chunk {
    background-color: {{colors.accent_primary}};
}

QProgressBar#resourceBar[resourceType="health"]::chunk {
    background-color: {{colors.danger}};
}

QProgressBar#resourceBar[resourceType="stamina"]::chunk {
    background-color: {{colors.experience}};
}

QProgressBar#resourceBar[resourceType="experience"]::chunk {
    background-color: {{colors.success}};
}

QTabBar::tab {
    background-color: {{colors.background_elevated}};
    color: {{colors.text_secondary}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    padding: {{spacing.space_sm}} {{spacing.space_md}};
}

QTabBar::tab:selected {
    background-color: {{colors.panel_surface_alt}};
    color: {{colors.accent_primary}};
    border-color: {{colors.border_highlight}};
}

QCheckBox#objectiveItem:disabled {
    color: {{colors.text_secondary}};
}

QCheckBox {
    color: {{colors.text_primary}};
}

QCheckBox:disabled {
    color: {{colors.text_muted}};
}

QCheckBox#objectiveItem[objectiveState="complete"]:disabled {
    color: {{colors.success}};
}

QLineEdit#playerActionInput {
    background-color: {{colors.background_primary}};
    color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_highlight}};
    padding: {{spacing.space_sm}};
}

QScrollArea#utilityContentScroll, QWidget#utilityOverview {
    background-color: transparent;
    border: none;
}

QFrame#playerSkillsRegion, QFrame#combatSkillsRegion {
    background-color: {{colors.panel_surface}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
}

QFrame#inventorySlot, QFrame#equipmentSlot, QFrame#skillGridItem,
QFrame#questListItem {
    background-color: {{colors.panel_surface_alt}};
    color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
}

QFrame#questListItem[selected="true"] {
    border: 2px solid {{colors.accent_primary}};
    background-color: {{colors.selection}};
}

QFrame#questListItem:hover[completed="false"],
QFrame#questListItem:focus[completed="false"] {
    border: 2px solid {{colors.accent_primary}};
}

QFrame#questListItem[expanded="true"] {
    border-color: {{colors.border_highlight}};
}

QFrame#questListItem[completed="true"] {
    background-color: {{colors.background_secondary}};
    border-color: {{colors.text_muted}};
}

QFrame#questListItem[completed="true"] QLabel,
QFrame#questListItem[completed="true"] QProgressBar {
    color: {{colors.text_muted}};
}

QFrame#questListItem[completed="true"] QProgressBar::chunk {
    background-color: {{colors.text_muted}};
}

QWidget#questObjectiveDropdown {
    background-color: {{colors.background_primary}};
    border-top: 1px solid {{colors.border_primary}};
}

QLabel#questListState, QLabel#questExpandedSummary,
QLabel#questObjectiveEntry, QLabel#questObjectiveEmpty, QLabel#questProgressLabel {
    color: {{colors.text_secondary}};
}

QLabel#questProgressLabel { font-size: {{typography.size_small}}; }

QLabel#questObjectiveTitle, QLabel#questRewardPreview {
    color: {{colors.accent_primary}};
    font-weight: {{typography.weight_bold}};
}

QLabel#questObjectiveEntry[objectiveComplete="true"] {
    color: {{colors.success}};
}

QLabel#questDeadline {
    color: {{colors.warning}};
}

QFrame#inventorySlot[empty="true"], QFrame#equipmentSlot[empty="true"] {
    background-color: {{colors.background_secondary}};
    border-color: {{colors.text_muted}};
}

QFrame#inventorySlot[rarity="common"], QFrame#equipmentSlot[rarity="common"],
QFrame#itemHoverCard[rarity="common"] { border-color: {{colors.rarity_common}}; }
QFrame#inventorySlot[rarity="uncommon"], QFrame#equipmentSlot[rarity="uncommon"],
QFrame#itemHoverCard[rarity="uncommon"] { border-color: {{colors.rarity_uncommon}}; }
QFrame#inventorySlot[rarity="rare"], QFrame#equipmentSlot[rarity="rare"],
QFrame#itemHoverCard[rarity="rare"] { border-color: {{colors.rarity_rare}}; }
QFrame#inventorySlot[rarity="epic"], QFrame#equipmentSlot[rarity="epic"],
QFrame#itemHoverCard[rarity="epic"] { border-color: {{colors.rarity_epic}}; }
QFrame#inventorySlot[rarity="legendary"], QFrame#equipmentSlot[rarity="legendary"],
QFrame#itemHoverCard[rarity="legendary"] { border-color: {{colors.rarity_legendary}}; }

QFrame#inventorySlot[rarity="common"] QLabel#inventorySlotName,
QFrame#equipmentSlot[rarity="common"] QLabel#equipmentItemName { color: {{colors.rarity_common}}; }
QFrame#inventorySlot[rarity="uncommon"] QLabel#inventorySlotName,
QFrame#equipmentSlot[rarity="uncommon"] QLabel#equipmentItemName { color: {{colors.rarity_uncommon}}; }
QFrame#inventorySlot[rarity="rare"] QLabel#inventorySlotName,
QFrame#equipmentSlot[rarity="rare"] QLabel#equipmentItemName { color: {{colors.rarity_rare}}; }
QFrame#inventorySlot[rarity="epic"] QLabel#inventorySlotName,
QFrame#equipmentSlot[rarity="epic"] QLabel#equipmentItemName { color: {{colors.rarity_epic}}; }
QFrame#inventorySlot[rarity="legendary"] QLabel#inventorySlotName,
QFrame#equipmentSlot[rarity="legendary"] QLabel#equipmentItemName { color: {{colors.rarity_legendary}}; }

QFrame#inventorySlot[questItem="true"] QLabel#inventorySlotName {
    color: {{colors.quest}};
}

QFrame#inventorySlot[durabilityState="low"] QLabel#inventorySlotDetails {
    color: {{colors.danger}};
}

QLabel#inventorySlotName, QLabel#equipmentItemName, QLabel#skillName,
QLabel#questListTitle {
    color: {{colors.text_primary}};
}

QLabel#inventorySlotDetails, QLabel#equipmentSlotName,
QLabel#equipmentItemDetails {
    color: {{colors.text_muted}};
    font-size: {{typography.size_small}};
}

QLabel#skillLevel {
    color: {{colors.accent_primary}};
    font-weight: {{typography.weight_bold}};
}

QFrame#skillGridItem[recentlyIncreased="true"] {
    border-color: {{colors.success}};
}

QFrame#skillGridItem[locked="true"] {
    color: {{colors.text_muted}};
    background-color: {{colors.background_secondary}};
}

QProgressBar#skillExperienceBar {
    border: none;
    background-color: {{colors.background_primary}};
    min-height: 3px;
    max-height: 3px;
}

QProgressBar#skillExperienceBar::chunk {
    background-color: {{colors.accent_primary}};
}

QProgressBar#questProgress {
    background-color: {{colors.background_primary}};
    color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    min-height: 13px;
    text-align: center;
    font-size: {{typography.size_small}};
}

QProgressBar#questProgress::chunk {
    background-color: {{colors.success}};
}

QLabel#questListEmptyState, QLabel#eventLogEmptyState,
QLabel#recentEventsEmptyState, QLabel#skillsGridEmptyState,
QLabel#equipmentGridEmptyState {
    color: {{colors.text_muted}};
    padding: {{spacing.space_md}};
}
QScrollArea#eventLogScrollArea,
QScrollArea#recentEventsScrollArea,
QScrollArea#questList,
QScrollArea#eventLogScrollArea QWidget#qt_scrollarea_viewport,
QScrollArea#recentEventsScrollArea QWidget#qt_scrollarea_viewport,
QScrollArea#questList QWidget#qt_scrollarea_viewport,
QWidget#eventEntries,
QWidget#recentEventEntries,
QWidget#questListContent {
    background-color: transparent;
    border: none;
}


QScrollBar:vertical {
    background-color: {{colors.background_primary}};
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: {{colors.border_highlight}};
    border-radius: {{geometry.border_radius_small}};
    min-height: 24px;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QComboBox, QPushButton {
    background-color: {{colors.panel_surface_alt}};
    color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
    padding: {{spacing.space_sm}} {{spacing.space_md}};
}

QComboBox:hover, QPushButton:hover {
    background-color: {{colors.hover}};
    border-color: {{colors.border_highlight}};
}

QComboBox:focus, QPushButton:focus {
    border: 2px solid {{colors.accent_primary}};
}

QPushButton:disabled {
    color: {{colors.text_muted}};
    background-color: {{colors.background_secondary}};
}

QComboBox QAbstractItemView {
    background-color: {{colors.panel_surface_alt}};
    color: {{colors.text_primary}};
    selection-background-color: {{colors.selection}};
    selection-color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_highlight}};
}

QSplitter::handle {
    background-color: {{colors.border_primary}};
    width: 3px;
    height: 3px;
}

QSplitter::handle:hover {
    background-color: {{colors.border_highlight}};
}

QSplitter::handle:pressed {
    background-color: {{colors.accent_primary}};
}

QToolTip {
    background-color: {{colors.panel_surface_alt}};
    color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_highlight}};
    padding: {{spacing.space_sm}};
}

QPushButton[buttonRole="primary"] {
    background-color: {{colors.accent_secondary}};
    color: {{colors.text_primary}};
    border: 2px solid {{colors.accent_primary}};
    font-weight: {{typography.weight_bold}};
}

QPushButton[buttonRole="primary"]:disabled {
    color: {{colors.text_muted}};
    background-color: {{colors.background_secondary}};
    border-color: {{colors.border_primary}};
}

QPushButton[buttonRole="navigation"] {
    background-color: {{colors.background_elevated}};
    color: {{colors.text_secondary}};
    min-width: 82px;
}

QPushButton[buttonRole="navigation"][selected="true"] {
    background-color: {{colors.selection}};
    color: {{colors.text_primary}};
    border: 2px solid {{colors.accent_primary}};
}

QPushButton[buttonRole="destructive"] {
    color: {{colors.danger}};
    border-color: {{colors.danger}};
}

QPushButton:pressed {
    background-color: {{colors.selection}};
}

QLineEdit#playerActionInput[validationState="error"] {
    border: 2px solid {{colors.danger}};
}

QLineEdit#playerActionInput[validationState="valid"] {
    border: 2px solid {{colors.success}};
}

QLabel#actionFeedback[feedbackState="success"] {
    color: {{colors.success}};
}

QLabel#actionFeedback[feedbackState="error"] {
    color: {{colors.danger}};
}

QLabel#actionFeedback[feedbackState="warning"] {
    color: {{colors.warning}};
}

QTabBar:focus {
    border: 2px solid {{colors.accent_primary}};
}

QMenu, QStatusBar#applicationStatusBar {
    background-color: {{colors.background_elevated}};
    color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
}

QMenu::item:selected {
    background-color: {{colors.selection}};
}

QWidget#navigationPageContent, QWidget#fullInventoryContent,
QWidget#inventoryUtilityContent, QScrollArea#fullInventoryScroll {
    background-color: transparent;
    border: none;
}

QLabel#navigationPageTitle {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_display}}";
    font-size: {{typography.size_title}};
    font-weight: {{typography.weight_bold}};
}

QWidget#pageActionBar QPushButton {
    padding: {{spacing.space_xs}} {{spacing.space_md}};
}

QLineEdit, QPlainTextEdit, QListWidget, QSpinBox {
    background-color: {{colors.background_primary}};
    color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
    padding: {{spacing.space_sm}};
    selection-background-color: {{colors.selection}};
}

QLineEdit:focus, QPlainTextEdit:focus, QListWidget:focus, QSpinBox:focus {
    border: 2px solid {{colors.accent_primary}};
}

QListWidget::item {
    padding: {{spacing.space_sm}};
}

QListWidget::item:selected {
    background-color: {{colors.selection}};
    color: {{colors.text_primary}};
}

QTabWidget::pane {
    background-color: {{colors.panel_surface}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
}

QWidget[creationSurface="true"], QScrollArea[creationSurface="true"] {
    background-color: transparent;
    border: none;
}

QLabel#characterCreationReview {
    background-color: {{colors.panel_surface_alt}};
    color: {{colors.text_primary}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    padding: {{spacing.space_lg}};
}

QLabel#characterCreationError {
    color: {{colors.danger}};
}

QFrame#characterCreationPanel QLabel {
    color: {{colors.text_primary}};
}

QFrame#characterCreationPanel QLabel#characterCreationError {
    color: {{colors.danger}};
}

QFrame#characterCreationPanel QLabel#skillAllocationCounter {
    color: {{colors.warning}};
}

QFrame#characterCreationPanel QLabel#skillAllocationCounter[textRole="success"] {
    color: {{colors.success}};
}

QFrame#characterCreationPanel QLabel#personalityAllocationCounter {
    color: {{colors.warning}};
}

QFrame#characterCreationPanel QLabel#personalityAllocationCounter[textRole="success"] {
    color: {{colors.success}};
}

QSpinBox#ageCreationSpin {
    color: {{colors.text_primary}};
}

QFrame#characterCreationPanel *[validationState="error"] {
    border: 2px solid {{colors.danger}};
}

QWidget#randomizableField {
    background-color: transparent;
}

QDialog#characterOptionDialog {
    background-color: {{colors.background_secondary}};
    color: {{colors.text_primary}};
}

QLabel#characterOptionDialogTitle {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_heading}}";
    font-size: {{typography.size_heading_1}};
    font-weight: {{typography.weight_bold}};
}
QDialog#combatRewardsDialog {
    background-color: {{colors.background_secondary}};
    color: {{colors.text_primary}};
}

QLabel#combatRewardsTitle {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_display}}";
    font-size: {{typography.size_title}};
    font-weight: {{typography.weight_bold}};
}

QLabel#combatRewardsOutcome, QLabel#combatRewardDetail,
QLabel#combatRewardItemText, QLabel#combatRewardEmpty {
    color: {{colors.text_primary}};
}

QLabel#combatRewardSectionTitle {
    color: {{colors.text_secondary}};
    font-size: {{typography.size_heading_1}};
    font-weight: {{typography.weight_bold}};
}

QFrame#combatRewardTotals, QFrame#combatRewardItem {
    background-color: {{colors.panel_surface_alt}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
}

QLabel#combatRewardTotal {
    color: {{colors.loot}};
    font-size: {{typography.size_heading_2}};
    font-weight: {{typography.weight_bold}};
}

QFrame#combatRewardItem[rarity="common"] { border-color: {{colors.rarity_common}}; }
QFrame#combatRewardItem[rarity="uncommon"] { border-color: {{colors.rarity_uncommon}}; }
QFrame#combatRewardItem[rarity="rare"] { border-color: {{colors.rarity_rare}}; }
QFrame#combatRewardItem[rarity="epic"] { border-color: {{colors.rarity_epic}}; }
QFrame#combatRewardItem[rarity="legendary"] { border-color: {{colors.rarity_legendary}}; }

QScrollArea#combatRewardItemsScroll, QWidget#combatRewardItems {
    background-color: transparent;
    border: none;
}

QLabel#combatRewardFeedback[feedbackState="success"] { color: {{colors.success}}; }
QLabel#combatRewardFeedback[feedbackState="warning"] { color: {{colors.warning}}; }

QFrame#combatSkillItem, QPushButton#npcSelectionButton {
    border: 1px solid {{colors.border_primary}};
    background: {{colors.panel_surface_alt}};
    color: {{colors.text_primary}};
}
QFrame#combatSkillItem[available="false"] { color: {{colors.text_muted}}; }
QLabel#combatSkillName { color: {{colors.accent_primary}}; font-weight: 700; }
QLabel#combatSkillCost { color: {{colors.text_secondary}}; }
QDialog#questRewardsDialog {
    background-color: {{colors.background_secondary}};
    color: {{colors.text_primary}};
}

QLabel#questRewardsTitle {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_display}}";
    font-size: {{typography.size_title}};
    font-weight: {{typography.weight_bold}};
}

QLabel#questRewardsQuestTitle, QLabel#questRewardSectionTitle {
    color: {{colors.text_primary}};
    font-size: {{typography.size_heading_1}};
    font-weight: {{typography.weight_bold}};
}

QFrame#questRewardTotals, QFrame#questRewardItem {
    background-color: {{colors.panel_surface_alt}};
    border: {{geometry.border_width}} solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
}

QLabel#questRewardTotal {
    color: {{colors.loot}};
    font-size: {{typography.size_heading_2}};
    font-weight: {{typography.weight_bold}};
}

QLabel#questRewardItemText, QLabel#questRewardEmpty { color: {{colors.text_primary}}; }
QLabel#questRewardFeedback[feedbackState="success"] { color: {{colors.success}}; }
QLabel#questRewardFeedback[feedbackState="warning"] { color: {{colors.warning}}; }

QFrame#worldMapPanel, QScrollArea#worldMapScroll, QWidget#worldMapContent {
    background-color: transparent;
    border: none;
}

QLabel#mapCompass, QLabel#travelDetailsTitle {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_display}}";
    font-size: {{typography.size_heading_1}};
    font-weight: {{typography.weight_bold}};
}

QPushButton#mapLocationNode {
    min-width: 150px;
    min-height: 72px;
    background-color: {{colors.panel_surface_alt}};
    color: {{colors.text_primary}};
    border: 1px solid {{colors.border_primary}};
}

QPushButton#mapLocationNode:hover, QPushButton#mapLocationNode[selected="true"] {
    border: 2px solid {{colors.accent_primary}};
    background-color: {{colors.selection}};
}

QPushButton#mapLocationNode[current="true"] {
    border: 2px solid {{colors.success}};
    background-color: {{colors.selection}};
    font-weight: {{typography.weight_bold}};
}

QLabel#travelDestinationName, QLabel#travelConfirmationDestination {
    color: {{colors.accent_primary}};
    font-size: {{typography.size_heading_1}};
    font-weight: {{typography.weight_bold}};
}

QLabel#travelRouteDescription, QLabel#lastJourneyLabel,
QLabel#travelConfirmationDetail { color: {{colors.text_secondary}}; }
QLabel#travelRouteStats { color: {{colors.text_primary}}; }
QLabel#travelRouteRequirement, QLabel#travelConfirmationWarning { color: {{colors.warning}}; }

QDialog#travelConfirmationDialog {
    background-color: {{colors.background_secondary}};
    color: {{colors.text_primary}};
}

QLabel#travelConfirmationTitle {
    color: {{colors.accent_primary}};
    font-family: "{{typography.font_display}}";
    font-size: {{typography.size_title}};
    font-weight: {{typography.weight_bold}};
}

QFrame#itemHoverCard, QFrame#responseHoverCard {
    background-color: {{colors.panel_surface_alt}};
    border: 1px solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_medium}};
}

QLabel#itemHoverName {
    color: {{colors.accent_primary}};
    font-weight: {{typography.weight_bold}};
}

QLabel#itemHoverDetail, QLabel#responseHoverText {
    color: {{colors.text_primary}};
}

QLabel#itemHoverDescription {
    color: {{colors.text_secondary}};
    font-style: italic;
    padding-top: {{spacing.space_sm}};
    border-top: 1px solid {{colors.border_primary}};
}

/* Release 26.3 circular inventory and equipment wells. */
QFrame#inventorySlot, QFrame#equipmentSlot {
    background: {{colors.background_primary}};
    border-width: 2px;
    border-style: solid;
    border-radius: 39px;
    padding: 0;
}
QLabel#equipmentSlotName {
    background: {{colors.background_primary}};
    color: {{colors.text_muted}};
    border: none;
    font-size: 8px;
    padding: 0;
}
QLabel#itemQuantityBadge {
    background: {{colors.background_primary}};
    color: {{colors.accent_primary}};
    border: 1px solid {{colors.border_highlight}};
    border-radius: 9px;
    font-weight: {{typography.weight_bold}};
    font-size: 10px; /* font-scale-fixed */
    padding: 0;
}

QLabel[recentTurn="true"] {
    background-color: {{colors.selection}};
    border-left: 2px solid {{colors.accent_primary}};
    padding-left: 5px;
}

/* Release 26.6 shared character-sheet and hover-card structure. */
QWidget#inventoryGrid, QScrollArea#characterSheetScroll,
QScrollArea#characterSheetScroll QWidget#qt_scrollarea_viewport,
QWidget#characterSheetViewport { background: transparent; border: none; }

QFrame#characterCreationSheetSurface {
    background: {{colors.panel_surface}};
    border: 1px solid {{colors.border_primary}};
    border-radius: {{geometry.border_radius_small}};
}
QFrame#characterCreationSheetSurface { border: 2px solid {{colors.border_highlight}}; }
QLabel#characterSheetAttributeValue, QLabel#characterSheetVitalValue,
QLabel#characterSheetModifier { color: {{colors.accent_primary}}; font-weight: {{typography.weight_bold}}; }

QFrame#itemHoverCard, QFrame#abilityHoverCard {
    background: {{colors.background_elevated}};
    color: {{colors.text_primary}};
    border: 2px solid {{colors.border_highlight}};
    border-radius: {{geometry.border_radius_medium}};
}

QFrame#itemHoverCard {
    background: transparent;
    border: none;
}

QFrame#itemHoverSurface {
    background: rgba(33, 30, 22, 255);
    color: {{colors.text_primary}};
    border: 2px solid {{colors.border_highlight}};
    border-radius: {{geometry.border_radius_medium}};
}
QLabel#hoverCardTitle { color: {{colors.accent_primary}}; font-size: {{typography.size_heading_1}}; font-weight: {{typography.weight_bold}}; }
QLabel#equippedComparisonLabel {
    color: {{colors.success}};
    font-size: {{typography.size_heading_2}};
    font-weight: {{typography.weight_bold}};
}
QLabel#hoverCardClassification, QLabel#abilityHoverStatName { color: {{colors.text_secondary}}; font-weight: {{typography.weight_bold}}; }
QLabel#abilityHoverStatValue, QLabel#abilityHoverDescription, QLabel#itemHoverDescription { color: {{colors.text_primary}}; }
QLabel#abilityHoverUnavailable { color: {{colors.danger}}; font-weight: {{typography.weight_bold}}; }
QFrame#hoverCardDivider { color: {{colors.border_highlight}}; background: {{colors.border_highlight}}; border: none; min-height: 1px; max-height: 1px; }

/* Square, touching inventory art and the themed 3x3 equipment board. */
QLabel#inventorySlotArtwork, QLabel#equipmentSlotArtwork, QLabel#equipmentBoardArtwork,
QLabel#equipmentOccupiedArtwork {
    background: transparent;
    border: none;
}
QFrame#inventorySlot, QFrame#equipmentSlot {
    background: transparent;
    border: 2px solid transparent;
    border-radius: 0;
    padding: 0;
}
QFrame#equipmentSlot { border-width: 1px; }
QFrame#inventorySlot[rarity="common"], QFrame#equipmentSlot[rarity="common"],
QFrame#inventorySlot[rarity="uncommon"], QFrame#equipmentSlot[rarity="uncommon"],
QFrame#inventorySlot[rarity="rare"], QFrame#equipmentSlot[rarity="rare"],
QFrame#inventorySlot[rarity="epic"], QFrame#equipmentSlot[rarity="epic"],
QFrame#inventorySlot[rarity="legendary"], QFrame#equipmentSlot[rarity="legendary"] {
    border-color: transparent;
}
QFrame#inventorySlot[empty="true"], QFrame#equipmentSlot[empty="true"] {
    background: transparent;
    border-color: transparent;
}
QFrame#itemHoverSurface[rarity="common"] { border-color: {{colors.rarity_common}}; }
QFrame#itemHoverSurface[rarity="uncommon"] { border-color: {{colors.rarity_uncommon}}; }
QFrame#itemHoverSurface[rarity="rare"] { border-color: {{colors.rarity_rare}}; }
QFrame#itemHoverSurface[rarity="epic"] { border-color: {{colors.rarity_epic}}; }
QFrame#itemHoverSurface[rarity="legendary"] { border-color: {{colors.rarity_legendary}}; }
QFrame#itemHoverSurface[rarity="common"] QLabel#hoverCardTitle { color: {{colors.rarity_common}}; }
QFrame#itemHoverSurface[rarity="uncommon"] QLabel#hoverCardTitle { color: {{colors.rarity_uncommon}}; }
QFrame#itemHoverSurface[rarity="rare"] QLabel#hoverCardTitle { color: {{colors.rarity_rare}}; }
QFrame#itemHoverSurface[rarity="epic"] QLabel#hoverCardTitle { color: {{colors.rarity_epic}}; }
QFrame#itemHoverSurface[rarity="legendary"] QLabel#hoverCardTitle { color: {{colors.rarity_legendary}}; }

QProgressBar#resourceBar[resourceType="health"]::chunk {
    background-color: #c4473a;
}

QProgressBar#resourceBar[resourceType="stamina"]::chunk {
    background-color: #4b8fd8;
}

QProgressBar#resourceBar[resourceType="mana"]::chunk {
    background-color: #725bd8;
}

QProgressBar#resourceBar[resourceType="spell_slots"]::chunk {
    background-color: #b05fd3;
}

/* Concept T: character strip, paperdoll, skills */
QFrame#characterStrip { background: transparent; border: none; }
QLabel#characterStripName { font-family: "Georgia"; font-size: 22px; color: #f4e6c6; }
QLabel#characterStripClass { font-family: "Oxanium"; font-size: 10px; font-weight: 600; color: {{codex.muted}}; }
QLabel#characterStripPurse { font-family: "Oxanium"; font-size: 14px; font-weight: 600; color: {{codex.gold}}; }
QLabel#characterStripCarry { font-family: "Oxanium"; font-size: 11px; font-weight: 600; color: {{codex.muted}}; }
QLabel#codexResourceName { font-family: "Oxanium"; font-size: 9px; font-weight: 600; color: {{codex.muted}}; }
QLabel#codexResourceValue { font-family: "Oxanium"; font-size: 9px; font-weight: 600; color: {{codex.ink}}; }
QProgressBar#codexResourceBar {
    min-height: 7px; max-height: 7px;
    background: #0b0907; border: 1px solid #47371f; border-radius: 4px;
}
QProgressBar#codexResourceBar::chunk { border-radius: 3px; background: {{codex.gold}}; }
QProgressBar#codexResourceBar[resourceType="health"]::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8e2a22, stop:1 #d0503c); }
QProgressBar#codexResourceBar[resourceType="stamina"]::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2d5b80, stop:1 #4a9bd0); }
QProgressBar#codexResourceBar[resourceType="focus"]::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8a6b20, stop:1 #e0b44c); }
QProgressBar#codexResourceBar[resourceType="resolve"]::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6a4c8c, stop:1 #a57fd0); }
QProgressBar#codexResourceBar[resourceType="experience"]::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3f7a2e, stop:1 #7cc35a); }

QWidget#paperdollPanel { background: transparent; }
QWidget#paperdollPanel QFrame#equipmentSlot {
    background: #15110c; border-width: 8px; border-style: solid; border-radius: 0;
    border-image: url("../../assets/{{codex.frame_slot}}") 22 22 22 22 stretch stretch;
}
QWidget#paperdollPanel QFrame#equipmentSlot[empty="true"] { background: rgba(21, 17, 12, 150); }
QWidget#paperdollPanel QLabel#itemQuantityBadge { background: transparent; border: none; color: #ffffff; font-family: "Oxanium"; font-size: 10px; font-weight: 600; }
QLabel#paperdollSlotCaption { background: transparent; font-family: "Oxanium"; font-size: 8px; font-weight: 600; color: {{codex.muted}}; }
QLabel#paperdollPortrait {
    background: #15110c; border-width: 12px; border-style: solid;
    border-image: url("../../assets/{{codex.frame_slot}}") 22 22 22 22 stretch stretch;
    font-family: "Georgia"; font-size: 40px; color: {{codex.gold}};
}
QLabel#paperdollStats {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(12, 10, 8, 0), stop:1 rgba(12, 10, 8, 217));
    padding-bottom: 6px; font-family: "Oxanium"; font-size: 11px; font-weight: 600; color: {{codex.gold}};
}

QWidget#skillDetailList, QFrame#skillDetailRow { background: transparent; border: none; }
QLabel#skillDetailIcon { background: #15110c; border: 1px solid {{codex.gold_dark}}; border-radius: 4px; }
QLabel#skillDetailName { font-family: "Oxanium"; font-size: 12px; font-weight: 600; color: {{codex.ink}}; }
QLabel#skillDetailValue { font-family: "Oxanium"; font-size: 12px; font-weight: 600; color: {{codex.gold}}; }
QLabel#skillDetailDescription { font-size: 10px; color: {{codex.muted}}; }
QFrame#skillDetailRow[recentlyIncreased="true"] QLabel#skillDetailValue { color: {{codex.success}}; }
QFrame#skillDetailRow[locked="true"] QLabel { color: {{codex.muted}}; }
QProgressBar#skillDetailXpBar { min-height: 3px; max-height: 3px; background: #2a2116; border: none; border-radius: 0; }
QProgressBar#skillDetailXpBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #9a7436, stop:1 #e2bd6c); }
/* Concept T: inventory and powers */
QFrame[codexCard="true"] {
    border-width: 14px;
    border-style: solid;
    border-image: url("../../assets/codex/ui_panel_large.png") 26 26 26 26 stretch stretch;
    background: transparent;
}
QFrame#inventoryCard QFrame#inventorySlot {
    border-width: 7px;
    border-style: solid;
    border-image: url("../../assets/codex/ui_slot_frame.png") 22 22 22 22 stretch stretch;
    background-color: #15110c;
}
QFrame#inventoryCard QFrame#inventorySlot[empty="true"] {
    border-image: url("../../assets/codex/ui_slot_frame.png") 22 22 22 22 stretch stretch;
    background-color: rgba(21, 17, 12, 150);
}

QFrame[codexCard="true"] QWidget#codexCardHeadingRow,
QFrame[codexCard="true"] QWidget#powersColumn,
QFrame[codexCard="true"] QWidget#powersColumnEntries,
QScrollArea#inventoryCardScroll, QScrollArea#inventoryCardScroll > QWidget > QWidget,
QScrollArea#powersColumnScroll, QScrollArea#powersColumnScroll > QWidget > QWidget {
    background: transparent;
    border: none;
}
QLabel#codexCardHeading {
    font-family: "Oxanium";
    font-size: 10px;
    font-weight: 600;
    color: {{codex.gold}};
}
QLabel#codexCardCount, QLabel#inventoryCardCount {
    font-family: "Oxanium";
    font-size: 10px;
    font-weight: 600;
    color: {{codex.muted}};
}
QFrame#codexCardDivider {
    background-color: {{codex.gold_dark}};
    border: none;
}
QToolButton#inventoryCardAutoSort {
    font-family: "Oxanium";
    font-size: 10px;
    font-weight: 600;
    color: {{codex.muted}};
    background: transparent;
    border: none;
    padding: 0 2px;
}
QToolButton#inventoryCardAutoSort:hover, QToolButton#inventoryCardAutoSort:focus {
    color: {{codex.gold}};
}
QScrollArea#inventoryCardScroll QScrollBar:vertical,
QScrollArea#powersColumnScroll QScrollBar:vertical {
    background-color: #2a2116;
    width: 5px;
    border-radius: 2px;
    margin: 0;
}
QScrollArea#inventoryCardScroll QScrollBar::handle:vertical,
QScrollArea#powersColumnScroll QScrollBar::handle:vertical {
    background-color: {{codex.gold_dark}};
    border-radius: 2px;
    min-height: 24px;
}
QScrollArea#inventoryCardScroll QScrollBar::add-line:vertical,
QScrollArea#inventoryCardScroll QScrollBar::sub-line:vertical,
QScrollArea#powersColumnScroll QScrollBar::add-line:vertical,
QScrollArea#powersColumnScroll QScrollBar::sub-line:vertical,
QScrollArea#inventoryCardScroll QScrollBar::add-page:vertical,
QScrollArea#inventoryCardScroll QScrollBar::sub-page:vertical,
QScrollArea#powersColumnScroll QScrollBar::add-page:vertical,
QScrollArea#powersColumnScroll QScrollBar::sub-page:vertical {
    height: 0;
    background: transparent;
}
QFrame#inventoryCard QLabel#itemQuantityBadge {
    background: transparent;
    border: none;
    font-family: "Oxanium";
    font-size: 10px;
    font-weight: 600;
    color: {{codex.ink}};
}
QFrame#powerEntry {
    border: 1px solid #33281a;
    background-color: rgba(0, 0, 0, 46);
}
QFrame#powerEntry:hover, QFrame#powerEntry:focus {
    border-color: {{codex.gold_dark}};
}
QLabel#powerEntryIcon {
    border: 1px solid {{codex.gold_dark}};
    border-radius: 5px;
    background: transparent;
}
QLabel#powerEntryName {
    font-family: "Oxanium";
    font-size: 12px;
    font-weight: 600;
    color: {{codex.ink}};
    background: transparent;
}
QLabel#powerEntryDetail {
    font-size: 10px;
    color: {{codex.muted}};
    background: transparent;
}
QLabel#powerEntryStatus {
    font-family: "Oxanium";
    font-size: 9px;
    font-weight: 600;
    color: {{colors.warning}};
    background: transparent;
}
QLabel#powerEntryStatus[ready="true"] {
    color: {{codex.success}};
}
QFrame#powerEntry[available="false"] QLabel#powerEntryName,
QFrame#powerEntry[available="false"] QLabel#powerEntryDetail {
    color: {{colors.text_muted}};
}
QLabel#powersCardEmpty {
    color: {{codex.muted}};
    font-style: italic;
    background: transparent;
}
QToolButton#powersCardRest {
    font-family: "Oxanium"; font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    padding: 2px 12px; color: {{codex.gold}}; background: transparent;
    border-width: 9px; border-style: solid; border-radius: 0;
    border-image: url("../../assets/{{codex.frame_button_normal}}") 18 18 18 18 stretch stretch;
}
QToolButton#powersCardRest:hover, QToolButton#powersCardRest:focus {
    color: {{codex.ink}};
    border-image: url("../../assets/{{codex.frame_button_hover}}") 18 18 18 18 stretch stretch;
}
QToolButton#powersCardRest:pressed {
    border-image: url("../../assets/{{codex.frame_button_pressed}}") 18 18 18 18 stretch stretch;
}
QToolButton#powersCardRest:disabled {
    color: {{colors.text_muted}};
    border-image: url("../../assets/{{codex.frame_button_disabled}}") 18 18 18 18 stretch stretch;
}

/* Concept T: conversation */
QScrollArea#conversationView, QScrollArea#conversationView > QWidget#qt_scrollarea_viewport,
QWidget#conversationThread, QWidget#conversationNarratorRow, QWidget#conversationPlayerRow,
QWidget#conversationNpcRow, QWidget#conversationNotes {
    background: transparent;
    border: none;
}
QScrollArea#conversationView {
    qproperty-shadowColor: #000000;
    qproperty-highlightColor: {{codex.gold}};
}
QLabel#conversationNarrator {
    font-family: "Segoe UI"; font-size: 15px; color: #ede3cf;
    background: transparent; border: none; padding: 0 2px;
}
QLabel#conversationNarrator[messageKind="monologue"] { font-style: italic; }
QFrame#conversationPlayer {
    background: {{codex.bubble_player}}; border: 1px solid {{codex.bubble_player_border}};
    border-top-left-radius: 12px; border-top-right-radius: 12px;
    border-bottom-right-radius: 3px; border-bottom-left-radius: 12px;
}
QLabel#conversationPlayerText {
    font-family: "Segoe UI"; font-size: 14px; font-style: normal; color: #f4e2b9;
    background: transparent; border: none;
}
QLabel#conversationPortrait {
    border: 2px solid {{codex.gold_dark}}; border-radius: 6px; background: #15110c;
    font-family: "Georgia"; font-size: 18px; color: #e5c072;
}
QFrame#conversationNpc {
    background: {{codex.bubble_npc}}; border: 1px solid {{codex.gold_dark}};
    border-top-left-radius: 3px; border-top-right-radius: 12px;
    border-bottom-right-radius: 12px; border-bottom-left-radius: 12px;
}
QLabel#conversationSpeaker {
    font-family: "Oxanium"; font-size: 11px; font-weight: 600; color: #e5c072;
    background: transparent; border: none;
}
QLabel#conversationNpcText {
    font-family: "Segoe UI"; font-size: 15px; font-style: italic; color: #f6e6c4;
    background: transparent; border: none;
}
QFrame#conversationPlayer[recentTurn="true"], QFrame#conversationNpc[recentTurn="true"] {
    border-color: {{codex.gold}};
}
QLabel#conversationNote {
    font-family: "Oxanium"; font-size: 11px; font-weight: 600;
    padding: 2px 8px; border-radius: 4px; background: rgba(13, 11, 9, 217);
    border: 1px solid #3a3024; color: #9d8f76;
}
QLabel#conversationNote[noteKind="xp"] { color: #9ccd76; border-color: #4a6a33; }
QLabel#conversationNote[noteKind="item"] { color: #ecdcb6; border-color: #5a4a33; }
QLabel#conversationNote[noteKind="quest"] { color: #e5c072; border-color: #7d6034; }
QLabel#conversationNote[noteKind="relationship"] { color: #7fc7b8; border-color: #2f5a52; }
QScrollArea#conversationView QScrollBar:vertical {
    background: rgba(255, 255, 255, 20); width: 17px; margin: 20px 12px 6px 0; border: none; border-radius: 2px;
}
QScrollArea#conversationView QScrollBar::handle:vertical {
    background: {{codex.gold_dark}}; border-radius: 2px; min-height: 24px;
}
QScrollArea#conversationView QScrollBar::add-line:vertical,
QScrollArea#conversationView QScrollBar::sub-line:vertical {
    height: 0; border: none; background: transparent;
}
QScrollArea#conversationView QScrollBar::add-page:vertical,
QScrollArea#conversationView QScrollBar::sub-page:vertical {
    background: transparent;
}
/* Concept T: scene, quest, choices */
QWidget#sceneView { qproperty-overlayColor: #120e0a; }
QWidget#sceneNavTabs, QFrame#sceneConversationPlaceholder, QWidget#choiceGrid { background: transparent; border: none; }
QPushButton#sceneNavTab {
    font-family: "Oxanium"; font-size: 10px; font-weight: 600; letter-spacing: 1.4px;
    padding: 6px 16px; min-height: 0; border-radius: 0;
    color: {{codex.muted}}; background-color: rgba(14, 11, 8, 178); border: 1px solid #3a2e1d;
}
QPushButton#sceneNavTab:hover, QPushButton#sceneNavTab:focus { color: {{codex.ink}}; border-color: {{codex.gold_dark}}; }
QPushButton#sceneNavTab:checked { color: {{codex.gold}}; border-color: {{codex.gold}}; }
QWidget#sceneNavTabs[compact="true"] QPushButton#sceneNavTab { padding: 6px 7px; letter-spacing: 0.6px; }
QLabel#sceneClockLabel { font-family: "Oxanium"; font-size: 10px; font-weight: 600; letter-spacing: 0.8px; color: {{codex.muted}}; background: transparent; }
QLabel#sceneLocationTitle { font-family: "Georgia"; font-size: 38px; color: #f6ead0; background: transparent; }
QLabel#sceneLocationSubtitle { font-family: "Oxanium"; font-size: 11px; font-weight: 600; letter-spacing: 1.7px; color: #e8d9b8; background: transparent; }
QLabel#sceneChip {
    font-family: "Oxanium"; font-size: 10px; font-weight: 600; padding: 3px 9px;
    background-color: rgba(12, 9, 6, 199); border: 1px solid {{codex.gold_dark}}; color: #e8d6ae;
}
QLabel#sceneChip[dangerLevel="low"] { color: {{codex.success}}; }
QLabel#sceneChip[dangerLevel="elevated"] { color: {{colors.warning}}; }
QFrame[sceneCard="true"] { background-color: rgba(14, 11, 8, 209); border: 1px solid #4a3a22; }
QFrame[sceneCard="true"] QLabel, QFrame#encounterCombatant { background: transparent; border: none; }
QLabel#sceneCardHeading { font-family: "Oxanium"; font-size: 10px; font-weight: 600; letter-spacing: 2px; color: {{codex.gold}}; }
QWidget#questProgressRing {
    font-family: "Oxanium"; font-size: 12px; font-weight: 600;
    qproperty-ringColor: {{codex.gold}}; qproperty-trackColor: #3a2e1d;
    qproperty-holeColor: #16120d; qproperty-textColor: {{codex.ink}};
}
QLabel#questCardTitle { font-family: "Georgia"; font-size: 15px; color: #f6ead0; }
QLabel#questCardSummary { font-size: 11px; color: {{codex.muted}}; }
QLabel#questObjective { font-size: 12px; color: {{codex.ink}}; }
QLabel#questObjective[completed="true"] { color: {{codex.success}}; }
QWidget#questObjectiveMarker { color: {{codex.gold}}; background: transparent; }
QWidget#questObjectiveMarker[completed="true"] { color: {{codex.success}}; }
QFrame[sceneCard="true"] QLabel#questRewardChip { font-family: "Oxanium"; font-size: 9px; font-weight: 600; padding: 1px 6px; color: {{codex.gold}}; border: 1px solid {{codex.gold_dark}}; }
QLabel#encounterCombatantName { font-family: "Oxanium"; font-size: 12px; font-weight: 600; color: {{codex.ink}}; }
QFrame#encounterCombatant[activeTurn="true"] QLabel#encounterCombatantName { color: {{codex.gold}}; }
QFrame#encounterCombatant[targetSelected="true"] { border: 1px solid {{codex.gold}}; border-radius: 4px; padding: 2px 4px; }
QLabel#encounterCombatantStats { font-family: "Oxanium"; font-size: 9px; font-weight: 600; color: {{codex.muted}}; }
QLabel#encounterIntent { font-size: 11px; font-style: italic; color: {{colors.warning}}; }
QProgressBar#encounterHealthBar { min-height: 5px; max-height: 5px; background: #16120d; border: 1px solid #3a2e1d; border-radius: 2px; }
QProgressBar#encounterHealthBar::chunk { border-radius: 1px; background: {{colors.success}}; }
QProgressBar#encounterHealthBar[combatSide="enemy"]::chunk { background: {{colors.danger}}; }
QPushButton#sceneChoiceButton {
    min-height: 20px; padding: 0; text-align: left;
    border-width: 9px; border-style: solid; border-radius: 0; background: transparent;
    border-image: url("../../assets/{{codex.frame_button_normal}}") 18 18 18 18 stretch stretch;
}
QPushButton#sceneChoiceButton:hover, QPushButton#sceneChoiceButton:focus {
    border-image: url("../../assets/{{codex.frame_button_hover}}") 18 18 18 18 stretch stretch;
}
QPushButton#sceneChoiceButton:disabled QLabel { color: {{colors.text_muted}}; }
QLabel#sceneChoiceIcon, QLabel#sceneChoiceKey { background: transparent; border: none; }
QLabel#sceneChoiceText { font-family: "Georgia"; font-size: 12px; color: {{codex.ink}}; background: transparent; }
QLabel#sceneChoiceKey { font-family: "Oxanium"; font-size: 10px; font-weight: 600; color: {{codex.gold}}; }
QLineEdit#sceneActionInput {
    font-family: "Georgia"; font-style: italic; font-size: 13px; padding: 7px 2px;
    color: {{codex.ink}}; background: transparent; border: none; border-bottom: 1px solid {{codex.gold_dark}}; border-radius: 0;
}
QLineEdit#sceneActionInput:focus { border-bottom-color: {{codex.gold}}; }
QLineEdit#sceneActionInput:disabled { color: {{colors.text_muted}}; }
QLineEdit#sceneActionInput[validationState="error"] { border-bottom-color: {{colors.danger}}; }
QPushButton#sceneActButton {
    font-family: "Oxanium"; font-size: 12px; font-weight: 600; letter-spacing: 1.7px;
    padding: 8px 22px; border: none; border-radius: 0;
    color: #1a140c; background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e7c27a, stop:1 #b48a45);
}
QPushButton#sceneActButton:hover, QPushButton#sceneActButton:focus { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #f0d08c, stop:1 #c49a55); }
QPushButton#sceneActButton:disabled { color: {{colors.text_muted}}; background: #3a2e1d; }

/* Concept T: tooltip cards */
QFrame#itemHoverCard, QFrame#abilityHoverCard, QFrame#skillHoverCard, QFrame#responseHoverCard {
    border-width: 16px; border-style: solid; border-radius: 0; background: transparent; padding: 0 4px;
    border-image: url("../../assets/{{codex.frame_tooltip}}") 24 24 24 24 stretch stretch;
}
QLabel#tooltipName { font-family: "Georgia"; font-size: 16px; color: {{codex.ink}}; background: transparent; }
QLabel#tooltipName[tone="common"] { color: {{codex.rarity_common}}; }
QLabel#tooltipName[tone="uncommon"] { color: {{codex.rarity_uncommon}}; }
QLabel#tooltipName[tone="rare"] { color: {{codex.rarity_rare}}; }
QLabel#tooltipName[tone="epic"], QLabel#tooltipName[tone="spell"] { color: {{codex.rarity_epic}}; }
QLabel#tooltipName[tone="legendary"] { color: {{codex.rarity_legendary}}; }
QLabel#tooltipName[tone="ability"], QLabel#tooltipName[tone="skill"], QLabel#tooltipName[tone="response"] { color: {{codex.gold}}; }
QLabel#tooltipSubtitle { font-family: "Oxanium"; font-size: 10px; font-weight: 600; letter-spacing: 0.6px; color: {{codex.muted}}; background: transparent; }
QLabel#tooltipIcon { border: 1px solid {{codex.gold_dark}}; border-radius: 5px; background: #15110c; }
QLabel#tooltipIcon[tone="uncommon"] { border-color: {{codex.rarity_uncommon}}; }
QLabel#tooltipIcon[tone="rare"] { border-color: {{codex.rarity_rare}}; }
QLabel#tooltipIcon[tone="epic"], QLabel#tooltipIcon[tone="spell"] { border-color: {{codex.rarity_epic}}; }
QLabel#tooltipIcon[tone="legendary"] { border-color: {{codex.rarity_legendary}}; }
QLabel#tooltipBadge {
    font-family: "Oxanium"; font-size: 9px; font-weight: 600; padding: 1px 5px; border-radius: 0;
    color: {{codex.gold}}; border: 1px solid {{codex.gold_dark}}; background: transparent;
}
QLabel#tooltipBadge[badgeTone="ready"] { color: {{codex.success}}; border-color: {{codex.success}}; }
QLabel#tooltipBadge[badgeTone="cooldown"] { color: {{colors.warning}}; border-color: {{colors.warning}}; }
QFrame#tooltipDivider { background: #3d3020; border: none; min-height: 1px; max-height: 1px; }
QLabel#tooltipStatName { font-family: "Oxanium"; font-size: 10px; font-weight: 600; color: {{codex.muted}}; background: transparent; }
QLabel#tooltipStatValue { font-family: "Georgia"; font-size: 12px; color: {{codex.ink}}; background: transparent; }
QLabel#tooltipDescription { font-family: "Georgia"; font-size: 13px; font-style: italic; color: {{codex.ink}}; background: transparent; padding-top: 4px; }
QLabel#tooltipFooter { font-family: "Oxanium"; font-size: 10px; font-weight: 600; letter-spacing: 0.4px; color: {{codex.muted}}; background: transparent; padding-top: 4px; }
QFrame#tooltipComparison { background: transparent; border: none; border-top: 1px dashed #3d3020; }
QLabel#tooltipComparisonTitle { font-family: "Oxanium"; font-size: 10px; font-weight: 600; color: {{codex.muted}}; background: transparent; }
QLabel#tooltipDelta { font-family: "Oxanium"; font-size: 10px; font-weight: 600; color: {{codex.muted}}; background: transparent; }
QLabel#tooltipDelta[better="true"] { color: {{codex.success}}; }
QLabel#tooltipDelta[better="false"] { color: {{colors.danger}}; }
QProgressBar#tooltipXpBar { min-height: 4px; max-height: 4px; border: none; border-radius: 0; background: #2a2116; }
QProgressBar#tooltipXpBar::chunk { border-radius: 0; background: {{codex.gold}}; }

/* Concept T: 1280x720 scroll hosts stay see-through */
QScrollArea#skillDetailList, QWidget#skillDetailListBody,
QScrollArea#sceneCardScroll, QWidget#sceneCardHost {
    background: transparent;
}

/* Settings sliders: volume and font size */
QSlider#musicVolumeSlider, QSlider#ambienceVolumeSlider, QSlider#fontSizeSlider, QSlider#sfxVolumeSlider, QSlider#diceRollSecondsSlider {
    min-height: 22px;
    background: transparent;
    border: none;
}

QSlider#musicVolumeSlider::groove:horizontal, QSlider#ambienceVolumeSlider::groove:horizontal,
QSlider#fontSizeSlider::groove:horizontal, QSlider#sfxVolumeSlider::groove:horizontal, QSlider#diceRollSecondsSlider::groove:horizontal {
    height: 4px;
    background: transparent;  /* the two pages draw the track */
    border: none;
}

QSlider#musicVolumeSlider::sub-page:horizontal, QSlider#ambienceVolumeSlider::sub-page:horizontal,
QSlider#fontSizeSlider::sub-page:horizontal, QSlider#sfxVolumeSlider::sub-page:horizontal, QSlider#diceRollSecondsSlider::sub-page:horizontal {
    height: 4px;
    background-color: {{colors.accent_primary}};
    border: none;
    border-radius: 2px;
}

/* both pages need an explicit height, or Qt stretches them over the whole widget */
QSlider#musicVolumeSlider::add-page:horizontal, QSlider#ambienceVolumeSlider::add-page:horizontal,
QSlider#fontSizeSlider::add-page:horizontal, QSlider#sfxVolumeSlider::add-page:horizontal, QSlider#diceRollSecondsSlider::add-page:horizontal {
    height: 4px;
    background-color: {{colors.border_primary}};
    border: none;
    border-radius: 2px;
}

QSlider#musicVolumeSlider::handle:horizontal, QSlider#ambienceVolumeSlider::handle:horizontal,
QSlider#fontSizeSlider::handle:horizontal, QSlider#sfxVolumeSlider::handle:horizontal, QSlider#diceRollSecondsSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -6px 0;
    background-color: {{colors.accent_primary}};
    border: 2px solid {{colors.panel_surface_alt}};
    border-radius: 8px;
}

QSlider#musicVolumeSlider::handle:horizontal:hover, QSlider#ambienceVolumeSlider::handle:horizontal:hover,
QSlider#fontSizeSlider::handle:horizontal:hover, QSlider#sfxVolumeSlider::handle:horizontal:hover, QSlider#diceRollSecondsSlider::handle:horizontal:hover,
QSlider#musicVolumeSlider::handle:horizontal:focus, QSlider#ambienceVolumeSlider::handle:horizontal:focus,
QSlider#fontSizeSlider::handle:horizontal:focus, QSlider#sfxVolumeSlider::handle:horizontal:focus, QSlider#diceRollSecondsSlider::handle:horizontal:focus {
    border: 2px solid {{colors.border_highlight}};
}

/* States go after the subcontrol here and above: Qt reads "QSlider:disabled::sub-page"
   as a rule for the whole widget and paints a box behind the slider. */
QSlider#musicVolumeSlider::sub-page:horizontal:disabled, QSlider#ambienceVolumeSlider::sub-page:horizontal:disabled,
QSlider#musicVolumeSlider::handle:horizontal:disabled, QSlider#ambienceVolumeSlider::handle:horizontal:disabled {
    background-color: {{colors.text_muted}};
}

/* Shared page cards: codex_cards.codex_card() frames, page headers */
QFrame[pageCard="true"] QLabel, QFrame[pageCard="true"] QWidget#pageCardRow { background: transparent; border: none; }
QLabel#pageCardLabel { font-family: "Oxanium"; font-size: 9px; font-weight: 600; letter-spacing: 0.8px; color: {{codex.muted}}; }
QLabel#pageCardValue, QLabel#characterSheetIdentityValue { font-size: 12px; color: {{codex.ink}}; }
QLabel#pageCardMeta { font-size: 10px; color: {{codex.muted}}; }
QLabel#pageCardName { font-family: "Oxanium"; font-size: 12px; font-weight: 600; color: {{codex.ink}}; }
QLabel#pageCardName[rarity="uncommon"] { color: {{colors.rarity_uncommon}}; }
QLabel#pageCardName[rarity="rare"] { color: {{colors.rarity_rare}}; }
QLabel#pageCardName[rarity="epic"] { color: {{colors.rarity_epic}}; }
QLabel#pageCardName[rarity="legendary"] { color: {{colors.rarity_legendary}}; }
QLabel#pageCardStat { font-family: "Oxanium"; font-size: 12px; font-weight: 600; color: {{codex.ink}}; }
QLabel#pageCardStat[proficient="true"] { color: {{codex.gold}}; }
QLabel#pageCardPurse { font-family: "Oxanium"; font-size: 14px; font-weight: 600; color: {{codex.gold}}; }
QLabel#pageCardNotice { font-family: "Oxanium"; font-size: 10px; font-weight: 600; color: {{colors.warning}}; }
QLabel#navigationPageSubtitle { font-family: "Oxanium"; font-size: 11px; font-weight: 600; letter-spacing: 0.5px; color: {{codex.muted}}; background: transparent; }
QLabel#characterSheetVitalValue { font-family: "Oxanium"; font-size: 16px; font-weight: 600; color: {{codex.gold}}; }
QLabel#characterSheetModifier { font-family: "Oxanium"; font-size: 11px; font-weight: 600; color: {{codex.gold}}; }
QLabel#mapCompass { font-family: "Oxanium"; font-size: 10px; font-weight: 600; letter-spacing: 2px; color: {{codex.muted}}; background: transparent; }
QLabel#travelRouteStats { font-family: "Oxanium"; font-size: 11px; font-weight: 600; color: {{codex.ink}}; }
QLabel#travelRouteDescription, QLabel#lastJourneyLabel { color: {{codex.muted}}; }
QPushButton#mapLocationNode {
    min-width: 150px; min-height: 64px; padding: 4px 8px;
    font-family: "Oxanium"; font-size: 11px; font-weight: 600; color: {{codex.ink}};
}

QLabel#navigationPageTitle { font-family: "Georgia"; font-size: 30px; font-weight: normal; color: #f6ead0; background: transparent; }
QLabel#characterSheetAttributeValue, QLabel#travelDestinationName { font-family: "Georgia"; font-size: 22px; font-weight: normal; color: #f6ead0; }
QFrame#characterSheetAttribute {
    background: #15110c; border-width: 7px; border-style: solid; border-radius: 0;
    border-image: url("../../assets/{{codex.frame_slot}}") 22 22 22 22 stretch stretch;
}
/* Map nodes wear the bronze slot frame; the current location the gold target line. */
QPushButton#mapLocationNode {
    background: #15110c; border-width: 8px; border-style: solid; border-radius: 0;
    border-image: url("../../assets/{{codex.frame_slot}}") 22 22 22 22 stretch stretch;
}
QPushButton#mapLocationNode:hover, QPushButton#mapLocationNode:focus, QPushButton#mapLocationNode[selected="true"] {
    background: #1d170f;
    border-image: url("../../assets/{{codex.frame_slot_selected}}") 22 22 22 22 stretch stretch;
}
QPushButton#mapLocationNode[current="true"] {
    border-image: none; border: 2px solid {{codex.gold}}; color: {{codex.gold}}; background: #1d170f;
}

/* People page: NPC list entries as codex slots */
QPushButton#npcSelectionButton {
    background: #15110c; border: 1px solid {{codex.gold_dark}}; border-radius: 0; padding: 6px 10px;
    text-align: left; font-family: "Oxanium"; font-size: 11px; font-weight: 600; color: {{codex.ink}};
}
QPushButton#npcSelectionButton:hover, QPushButton#npcSelectionButton:focus, QPushButton#npcSelectionButton[selected="true"] {
    background: #1d170f; border-color: {{codex.gold}}; color: {{codex.gold}};
}

/* Abilities / Spells level picker */
QToolButton#powerLevelButton {
    font-family: "Oxanium";
    font-size: 10px;
    font-weight: 600;
    color: {{codex.muted}};
    background: transparent;
    border: 1px solid {{codex.gold_dark}};
    border-radius: 3px;
    padding: 1px 6px;
}
QToolButton#powerLevelButton:hover { color: {{codex.ink}}; }
QToolButton#powerLevelButton:checked {
    color: {{codex.gold}};
    border-color: {{codex.gold}};
}

/* Quick-access hotbar */
QFrame#hotbar { background: transparent; border: none; }
QFrame#hotbarSlot {
    min-height: 40px;
    background-color: rgba(21, 17, 12, 170);
    border: 1px solid {{codex.gold_dark}};
    border-radius: 4px;
}
QFrame#hotbarSlot:hover { border-color: {{codex.gold}}; }
QFrame#hotbarSlot[empty="true"] { background-color: rgba(21, 17, 12, 90); }
QFrame#hotbarSlot[empty="false"][available="false"] { border-color: {{codex.muted}}; }
QLabel#hotbarSlotIcon { background: transparent; border: none; }
QLabel#hotbarSlotKey {
    background: transparent;
    font-family: "Oxanium";
    font-size: 10px;
    font-weight: 600;
    color: {{codex.gold}};
}
